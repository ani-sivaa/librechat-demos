#===================================================#
#               LibreChat Configuration             #
#===================================================#

# Core Configuration
MONGO_URI=mongodb://localhost:27017/librechat
HOST=localhost
PORT=3080

#===================================================#
#                FREE AI Model APIs                #
#===================================================#

# Google Gemini (FREE TIER - RECOMMENDED)
# Get your free API key at: https://ai.google.dev/
# Free limits: 15 RPM, 1M tokens/day
GOOGLE_KEY=your_free_gemini_api_key_here

# Groq (FREE TIER - OPTIONAL)
# Get your free API key at: https://console.groq.com/
# Free limits: 30 RPM, very fast inference
GROQ_API_KEY=your_free_groq_api_key_here

# Hugging Face (FREE TIER - OPTIONAL)
# Get your free API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_free_hf_token_here

#===================================================#
#                LOCAL MODELS (FREE)               #
#===================================================#

# Ollama (Completely Free - Unlimited Usage)
OLLAMA_BASE_URL=http://localhost:11434
# Available models: llama3.2, codellama, mistral, gemma2

#===================================================#
#                Search Configuration               #
#===================================================#

# Enable search functionality
SEARCH=true
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=demo_master_key
MEILI_NO_ANALYTICS=true

# Google Search (Optional - requires API key)
# GOOGLE_SEARCH_API_KEY=your_google_search_key
# GOOGLE_CSE_ID=your_custom_search_engine_id

#===================================================#
#                File Configuration                #
#===================================================#

# Firebase (Optional - free tier available)
# FIREBASE_API_KEY=your_firebase_key
# FIREBASE_AUTH_DOMAIN=your_domain.firebaseapp.com
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com

# Local file storage
FILES_BASE_URL=http://localhost:3080

#===================================================#
#             Assessment Platform Config            #
#===================================================#

# Assessment database (uses main MongoDB by default)
ASSESSMENT_DB_URI=mongodb://localhost:27017/librechat

# Code execution (Optional - paid service)
# LIBRECHAT_CODE_API_KEY=your_code_interpreter_key

#===================================================#
#                Security Settings                 #
#===================================================#

# JWT Secret (change in production)
JWT_SECRET=your_super_secret_jwt_string

# Session secret (change in production)  
SESSION_SECRET=your_super_secret_session_string

# Allowed domains for registration (optional)
ALLOWED_EMAIL_DOMAINS=youruniversity.edu,school.edu

#===================================================#
#               Educational Features               #
#===================================================#

# Enable user registration
ALLOW_REGISTRATION=true

# Enable social logins
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

#===================================================#
#                  Debug Settings                  #
#===================================================#

# Logging level
LOG_LEVEL=info

# Debug mode
DEBUG_LOGGING=false

# Console logging
DEBUG_CONSOLE=true

#===================================================#
#           Production Optimizations               #
#===================================================#

# Cache settings
CACHE_TTL=3600

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000

# Concurrent requests
MAX_CONCURRENT_REQUESTS=5

#===================================================#
#                 Model Configurations             #
#===================================================#

# Gemini specific settings
GOOGLE_MODELS=gemini-1.5-pro,gemini-1.5-flash,gemini-pro
GOOGLE_REVERSE_PROXY=false

# Ollama model settings
OLLAMA_MODELS=llama3.2:3b,codellama:7b,mistral:7b,gemma2:2b

# Default model preferences
DEFAULT_MODEL=gemini-1.5-flash
FALLBACK_MODEL=llama3.2:3b

#===================================================#
#              Educational Compliance              #
#===================================================#

# FERPA compliance settings
STUDENT_DATA_RETENTION_DAYS=2555  # 7 years
AUDIT_LOGGING=true
DATA_ENCRYPTION=true

# Privacy settings
ANONYMIZE_STUDENT_DATA=false
EXPORT_USER_DATA=true
DELETE_USER_DATA=true

#===================================================#
#                  Experimental                    #
#===================================================#

# Beta features
ENABLE_ARTIFACTS=true
ENABLE_AGENTS=true
ENABLE_MCP=true
ENABLE_CODE_INTERPRETER=true

# Performance settings
WORKER_PROCESSES=auto
ENABLE_CLUSTERING=false

#===================================================#
#                     Notes                        #
#===================================================#

# Cost Savings with This Setup:
# - Gemini Free Tier: $0/month (vs $7/1M tokens for paid)
# - Ollama Models: $0/month (vs $15-30/1M tokens for commercial APIs)
# - Estimated Annual Savings: $1,000-$10,000 for typical educational usage
#
# Getting Started:
# 1. Get free Gemini API key: https://ai.google.dev/
# 2. Copy this file to .env
# 3. Add your GOOGLE_KEY
# 4. Run: docker compose up -d
# 5. Visit: http://localhost:3080
